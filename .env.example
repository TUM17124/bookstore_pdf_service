# Port this service listens on.
PORT=8002

# Must match Django's SECRET_KEY (bookstore_backend/.env) exactly - used to
# verify the HS256 signature of JWTs issued by djangorestframework-simplejwt.
DJANGO_SECRET_KEY=

# Comma-separated list of origins allowed to call this service (CORS).
# Defaults to https://plugyard.com,https://www.plugyard.com if unset.
CORS_ALLOWED_ORIGINS=https://plugyard.com,https://www.plugyard.com

# Where /api/pdf/parse, /api/pdf/parse-from-s3, and /api/office/export fetch
# stored document bytes from (Django's editor document-download endpoint).
DJANGO_API_BASE_URL=http://127.0.0.1:8000

# Native OCR microservice (gigapdf-ocr-rten) URL, used by /api/pdf/ocr-page.
OCR_SERVICE_URL=http://127.0.0.1:8077

# Optional shared secret for trusted server-to-server callers with no user
# session. Leave unset to disable (isInternalServiceRequest fails closed).
INTERNAL_API_SECRET=
